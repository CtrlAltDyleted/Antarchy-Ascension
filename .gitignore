/eula.txt

# IDE/editor files

/.vscode/
/.idea/
/*.iml

# Operating system junk

/.DS_Store
/Thumbs.db
/desktop.ini

# Generated / transient config data
# Infinite Dimensions temporary/generated invocation data
/config/.infinity-temp.json
/config/infinity/modular/

# Ars Nouveau generated search index
/config/ars_nouveau/search_index/

# Temporary/backup config files
/config/*_backup*
/config/**/*.bak
/config/**/*.tmp
/config/**/*.lock

# FancyMenu runtime variable state
/config/fancymenu/user_variables.db

# Sodium installation fingerprint
/config/sodium-fingerprint.json

# Spark temporary files
/config/spark/tmp/
/config/spark/tmp-client/

# Crash Assistant generated mod snapshot
/config/crash_assistant/modlist.json

# Euphoria Patcher generated state

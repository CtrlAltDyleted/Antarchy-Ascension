/xaero/
/XaeroWaypoints/
/XaeroWorldMap/
/local/
/replay_recordings/
/recordings/
/debug/
/dumps/
/spark/
/observable/
/profiling/

# Runtime files

/latest.log
/debug.log
/*.log
/*.log.gz
/*.tmp
/*.temp
/*.lock
/*.lck
/*.bak
/*.old

# Java crash/runtime dumps

/hs_err_pid*
/replay_pid*
/java_pid*
/*.hprof
/*.heapdump


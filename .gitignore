!/local/ftbquests/**
/local/*
!/local/ftbquests/
!/local/ftbquests/**

# Scripts / custom pack files

!/scripts/
!/scripts/**

!/global_packs/
!/global_packs/**

!/openloader/
!/openloader/**

!/datapacks/
!/datapacks/**

# Custom resources

/resourcepacks/
/shaderpacks/

# FancyMenu / UI assets if used for pack customization

!/fancymenu_data/
!/fancymenu_data/**

!/customization/
!/customization/**

# Minecraft / CurseForge metadata

# !/options.txt
# !/optionsof.txt

# Explicit safety exclusions

/mods/
/mods/**
/saves/
/saves/**
/world/
/worlds/
/server/
/servers/
/logs/
/crash-reports/
/screenshots/
